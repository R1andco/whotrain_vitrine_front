---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/content';

const videos = (await getCollection('videos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const audienceLabel = {
  entreprises: 'Entreprises',
  intervenants: 'Intervenants',
  tous: 'Tous',
};
---

<Base
  title="Tutos"
  description="Tutoriels vidéo Whotrain, hébergés sur YouTube : inscription, prise en main et usages de la plateforme."
>
  <section class="wt-page">
    <div class="wt-wrap">
      <p class="wt-kicker">Vidéos</p>
      <h1>Tutos Whotrain</h1>
      <p class="wt-lead">Les vidéos restent sur YouTube. Cette page en donne le titre, le public et le résumé, pour les humains comme pour les agents.</p>
      <div class="wt-cards">
        {videos.map((video) => (
          <a class="wt-card" href={`/tutos/${video.id}`}>
            <img src={`https://i.ytimg.com/vi/${video.data.youtubeId}/hqdefault.jpg`} alt="" />
            <div>
              <p class="wt-kicker">{audienceLabel[video.data.audience]}</p>
              <strong>{video.data.title}</strong>
              <p>{formatDate(video.data.date)}</p>
              <p>{video.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
